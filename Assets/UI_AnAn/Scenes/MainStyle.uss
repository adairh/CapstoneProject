.background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("Assets/Scenes/Images/background.png");
    background-size: cover;
    background-position: center;
}

.button {
    width: 174px;
    height: 139px;
    -unity-text-align: middle-center;
    color: white;
    background-size: cover;
    background-position: center;
    border-radius: 10px;
}

.join-room {
    background-image: url("Assets/Scenes/Images/button_join.png");
}

.create-room {
    background-image: url("Assets/Scenes/Images/button_create.png");
}

.tips {
    background-image: url("Assets/Scenes/Images/button_tips.png");
}

.drawing {
    background-image: url("Assets/Scenes/Images/button_drawing.png");
}

/* Popup container */
.popup-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
}

/* Background to detect clicks */
.popup-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
}

/* Popup content */
.popup-content {
    width: 300px;
    height: 200px;
    background-color: white;
    padding: 20px;
    border-radius: 10px;
    text-align: center;
}

/* Bottom Navigation */
#BottomNav {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 60px;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    background-image: url("Assets/Scenes/Images/bottom_nav.png");
    background-size: cover;
    background-position: center;
}

.nav-button {
    width: 100px;
    height: 50px;
    background-size: cover;
    background-position: center;
    color: white;
}

#btnHome {
    background-image: url("Assets/Scenes/Images/button_home.png");
}

#btnFiles {
    background-image: url("Assets/Scenes/Images/button_files.png");
}

.welcome-label {
    font-size: 24px;
    color: white;
}
